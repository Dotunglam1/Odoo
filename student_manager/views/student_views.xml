<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.student.tree</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="age"/>
                <field name="sex"/>
                <field name="email"/>
            </tree>
        </field>
    </record>

    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.student.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="age"/>
                        <field name="sex"/>
                        <field name="address"/>
                        <field name="email"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_student_kanban" model="ir.ui.view">
        <field name="name">student.student.kanban</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="age"/>
                <field name="sex"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="age"/> - <field name="sex"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <menuitem id="menu_student_root" name="Student Manager" sequence="10" groups="student_manager.group_student,student_manager.group_teacher"/>
    <menuitem id="menu_student_students" name="Students" parent="menu_student_root" action="action_student"/>

    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>
</odoo>
