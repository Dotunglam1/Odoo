<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_student_manager" model="ir.module.category">
        <field name="name">Student Manager</field>
        <field name="sequence" eval="10"/>
    </record>

    <record id="group_student" model="res.groups">
        <field name="name">Student</field>
        <field name="category_id" ref="module_category_student_manager"/>
    </record>

    <record id="group_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="category_id" ref="module_category_student_manager"/>
    </record>

    <!-- Record rules -->
    <record id="student_rule_student" model="ir.rule">
        <field name="name">Student: own records</field>
        <field name="model_id" ref="model_student_student"/>
        <field name="domain_force">[("user_id", "=", user.id)]</field>
        <field name="groups" eval="[(4, ref('student_manager.group_student'))]"/>
    </record>

    <record id="student_rule_teacher" model="ir.rule">
        <field name="name">Teacher: all records</field>
        <field name="model_id" ref="model_student_student"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('student_manager.group_teacher'))]"/>
    </record>
</odoo>
